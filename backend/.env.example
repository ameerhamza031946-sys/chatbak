# AI Nexus Chat - Backend Environment Configurations

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (MongoDB Atlas or Local MongoDB)
# If left empty, the application will automatically fallback to an in-memory database.
MONGODB_URL=mongodb://localhost:27017/ai_nexus_chat

# Security Settings
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=supersecretjwtkey_please_change_this_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
